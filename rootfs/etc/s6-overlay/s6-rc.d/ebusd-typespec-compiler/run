#!/usr/bin/with-contenv bashio
set -e

bashio::log.info "Starting ebusd TypeSpec Compiler..."

# --- Node.js version check ---
# TypeSpec compilers >= 1.9 require Node.js >= 22 (fs.promises.glob).
# Fail with a clear message instead of a cryptic "fs/promises does not
# provide an export named 'glob'" crash during compilation.
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
if [ "${NODE_MAJOR}" -lt 22 ]; then
    bashio::log.fatal "Node.js >= 22 required, but this image runs $(node --version)."
    bashio::log.fatal "Please rebuild the add-on image (check that the base image ships Node.js >= 22)."
    /run/s6/basedir/bin/halt
    exit 1
fi

REPO_URL=$(bashio::config 'repo_url')
BRANCH=$(bashio::config 'branch')
OUTPUT_PATH=$(bashio::config 'output_path')
LANGUAGES=$(bashio::config 'languages')
if [ -z "${LANGUAGES}" ]; then
    LANGUAGES="de en"
fi

bashio::log.info "Repository : ${REPO_URL}"
bashio::log.info "Branch     : ${BRANCH}"
bashio::log.info "Languages  : ${LANGUAGES}"
bashio::log.info "Output     : ${OUTPUT_PATH}"

WORK_DIR="/tmp/ebusd-typespec-src"

[ -d "${WORK_DIR}" ] && rm -rf "${WORK_DIR}" || true

# 1. Clone repository
bashio::log.info "Cloning repository (branch: ${BRANCH})..."
git clone --depth=1 --branch "${BRANCH}" "${REPO_URL}" "${WORK_DIR}" \
    || { bashio::log.fatal "Clone failed!"; /run/s6/basedir/bin/halt; exit 1; }

cd "${WORK_DIR}"

# 2. Install the repository's pinned toolchain
#    (@typespec/compiler + @ebusd/ebus-typespec come from the target
#    repository's package.json, so the image itself stays version-agnostic)
bashio::log.info "Installing repo dependencies..."
if ! npm install --silent --no-save; then
    bashio::log.fatal "npm install failed!"
    bashio::log.warning "Hint: if the log above shows an ERESOLVE error, the target repository has outdated dependency pins (e.g. an unpinned @ebusd/ebus-typespec resolving to a newer release that requires a different @typespec/compiler). Fix the pins in the target repository."
    /run/s6/basedir/bin/halt
    exit 1
fi

# Validate the installed dependency tree: npm install can exit
# successfully even when the resolved tree contains peer-dependency
# conflicts (e.g. @typespec/asset-emitter resolving to a release that
# requires a newer @typespec/compiler than the repository pins). Such an
# inconsistent toolchain later fails with cryptic "missing-implementation"
# compiler errors, so fail early with the actual npm diagnosis instead.
NPM_LS_OUTPUT="$(npm ls --all --omit=dev 2>&1)" \
    || { bashio::log.fatal "The installed dependency tree is inconsistent!";
         bashio::log.warning "npm reports the following problems:";
         echo "${NPM_LS_OUTPUT}" | grep -E "missing|invalid|UNMET|error" | head -10 | while read -r line; do
             bashio::log.warning "  ${line}"
         done
         bashio::log.warning "Fix the dependency pins in the target repository's package.json.";
         /run/s6/basedir/bin/halt;
         exit 1; }

# 3. Generate src/main.tsp from all TSP source files
bashio::log.info "Generating src/main.tsp..."
npm run maintsp \
    || { bashio::log.fatal "maintsp failed!"; /run/s6/basedir/bin/halt; exit 1; }

# 4. Compile all languages and export to language-specific subdirectories
for LANG_CODE in ${LANGUAGES}; do
    bashio::log.info "Compiling TSP (language: ${LANG_CODE})..."
    npm run "compile-${LANG_CODE}" \
        || { bashio::log.fatal "Compilation failed for language: ${LANG_CODE}!"; /run/s6/basedir/bin/halt; exit 1; }

    # Dynamically locate the output directory produced by the compiler
    OUT_SRC=$(find "${WORK_DIR}" -type d -name "ebus-typespec" -path "*/@ebusd/*" \
        ! -path "*/node_modules/*" | head -1)

    if [ -z "${OUT_SRC}" ] || [ ! -d "${OUT_SRC}" ]; then
        bashio::log.fatal "Compiler output directory not found for language: ${LANG_CODE}!"
        /run/s6/basedir/bin/halt
        exit 1
    fi

    bashio::log.info "Compiler output found: ${OUT_SRC#${WORK_DIR}/}"

    # Export to language-specific subdirectory
    LANG_OUTPUT="${OUTPUT_PATH}/${LANG_CODE}"
    bashio::log.info "Exporting to ${LANG_OUTPUT}..."
    rm -rf "${LANG_OUTPUT}"
    mkdir -p "${LANG_OUTPUT}"
    cp -r "${OUT_SRC}/." "${LANG_OUTPUT}/" \
        || { bashio::log.fatal "Export failed for language: ${LANG_CODE}!"; /run/s6/basedir/bin/halt; exit 1; }

    COUNT=$(find "${LANG_OUTPUT}" -name "*.csv" | wc -l)
    bashio::log.info "Language '${LANG_CODE}': ${COUNT} CSV file(s) exported."

    # Remove compiler output before next language run
    rm -rf "${WORK_DIR}/outcsv"*
done

# Cleanup
rm -rf "${WORK_DIR}"

bashio::log.info "Done! CSV files exported to:"
for LANG_CODE in ${LANGUAGES}; do
    COUNT=$(find "${OUTPUT_PATH}/${LANG_CODE}" -name "*.csv" | wc -l)
    bashio::log.info "  ${OUTPUT_PATH}/${LANG_CODE}  (${COUNT} files)"
done

# Shut down the container cleanly
/run/s6/basedir/bin/halt
