#!/usr/bin/with-contenv bashio
set -e

fail() {
    bashio::log.fatal "$*"
    exit 1
}

# Always stop instead of restarting this batch job after a failed command.
cleanup() {
    local status=$?
    trap - EXIT
    cd /
    if [ -n "${WORK_DIR:-}" ]; then rm -rf -- "${WORK_DIR}"; fi
    /run/s6/basedir/bin/halt || true
    exit "${status}"
}
trap cleanup EXIT

bashio::log.info "Starting ebusd TypeSpec Compiler."
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
[ "${NODE_MAJOR}" -ge 22 ] || fail "Node.js >= 22 required. Please rebuild the add-on image."

REPO_URL=$(bashio::config 'repo_url')
BRANCH=$(bashio::config 'branch')
OUTPUT_PATH=$(bashio::config 'output_path')
LANGUAGES=$(bashio::config 'languages' || true)
DEPENDENCY_MODE=$(bashio::config 'dependency_mode' || true)
ENTRYPOINT=$(bashio::config 'entrypoint' || true)
IGNORE_COMPILE_ERRORS=$(bashio::config 'ignore_compile_errors' || true)
LANGUAGES=${LANGUAGES:-de en}
DEPENDENCY_MODE=${DEPENDENCY_MODE:-compatible}
IGNORE_COMPILE_ERRORS=${IGNORE_COMPILE_ERRORS:-false}
case "${IGNORE_COMPILE_ERRORS}" in
    true|false) ;;
    *) fail "ignore_compile_errors must be true or false." ;;
esac
ANY_COMPILE_ERRORS=false
case "${DEPENDENCY_MODE}" in
    compatible|repository) ;;
    *) fail "Unknown dependency_mode: ${DEPENDENCY_MODE}" ;;
esac
for LANG_CODE in ${LANGUAGES}; do
    case "${LANG_CODE}" in
        de|en) ;;
        *) fail "Unsupported language: ${LANG_CODE}" ;;
    esac
done

bashio::log.info "Repository: ${REPO_URL}"
bashio::log.info "Git ref: ${BRANCH}; languages: ${LANGUAGES}; dependencies: ${DEPENDENCY_MODE}"
bashio::log.info "Output: ${OUTPUT_PATH}"
if [ "${IGNORE_COMPILE_ERRORS}" = true ]; then
    bashio::log.warning "ignore_compile_errors is enabled: CSVs generated despite compiler errors may be exported. They can be incomplete or contain invalid/ambiguous definitions."
fi
WORK_DIR=$(mktemp -d /tmp/ebusd-typespec-src.XXXXXX)

# Fetch accepts both branch names and refs/pull/<number>/{head,merge}.
# Clone --branch does not accept GitHub's pull-request refs.
case "${BRANCH}" in
    pull/*) FETCH_REF="refs/${BRANCH}" ;;
    *) FETCH_REF="${BRANCH}" ;;
esac
[ -n "${FETCH_REF}" ] && [[ "${FETCH_REF}" != -* ]] || fail "Invalid Git ref."
git init -q "${WORK_DIR}"
git -C "${WORK_DIR}" remote add origin "${REPO_URL}"
git -C "${WORK_DIR}" fetch --depth=1 origin "${FETCH_REF}" || fail "Could not fetch Git ref."
git -C "${WORK_DIR}" checkout -q --detach FETCH_HEAD
SOURCE_SHA=$(git -C "${WORK_DIR}" rev-parse HEAD)
bashio::log.info "Source commit: ${SOURCE_SHA}"
cd "${WORK_DIR}"

if [ "${DEPENDENCY_MODE}" = compatible ]; then
    bashio::log.info "Resolving a compatible toolchain within the source repository's version constraints."
    node /opt/ebusd-typespec-compiler/resolve-toolchain.mjs "${WORK_DIR}" \
        || fail "No compatible toolchain found. See details above."
fi

# A locked repository-mode run is intentionally strict for reproducing CI.
# Do not run arbitrary npm install lifecycle scripts from a PR.
if [ "${DEPENDENCY_MODE}" = repository ] && { [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; }; then
    npm ci --ignore-scripts --no-audit --no-fund || fail "npm ci failed."
else
    npm install --ignore-scripts --no-audit --no-fund || fail "npm install failed."
fi

if ! npm ls --all > "${WORK_DIR}/dependency-tree.log" 2>&1; then
    cat "${WORK_DIR}/dependency-tree.log"
    fail "Dependency tree is inconsistent. See details above."
fi
[ -f node_modules/@typespec/compiler/cmd/tsp.js ] \
    || fail "Local TypeSpec compiler missing; automatic npx download is not allowed."
[ -f node_modules/@ebusd/ebus-typespec/package.json ] || fail "Local ebusd emitter missing."
node -p '"Installed: compiler " + require("./node_modules/@typespec/compiler/package.json").version + ", emitter " + require("./node_modules/@ebusd/ebus-typespec/package.json").version'

if [ -n "${ENTRYPOINT}" ]; then
    # Do not allow selecting a file outside the checked-out repository.
    ENTRYPOINT=$(node -e '
      const fs = require("node:fs"), path = require("node:path");
      const base = fs.realpathSync(process.argv[1]);
      const file = fs.realpathSync(path.resolve(base, process.argv[2]));
      if (!file.startsWith(base + path.sep) || !file.endsWith(".tsp") || !fs.statSync(file).isFile()) process.exit(1);
      console.log(file);
    ' "${WORK_DIR}" "${ENTRYPOINT}") || fail "Entrypoint must be an existing .tsp file inside the repository."
    bashio::log.info "Targeted test: ${ENTRYPOINT#${WORK_DIR}/} (not a full repository build)"
else
    npm run maintsp || fail "Generating src/main.tsp failed."
fi
mkdir "${WORK_DIR}/export-stage"
for LANG_CODE in ${LANGUAGES}; do
    # Discard generated output from the source checkout or the previous language.
    rm -rf -- "${WORK_DIR}/outcsv"*
    bashio::log.info "Compiling: ${LANG_CODE}"
    COMPILE_EXIT=0
    COMPILE_ERRORS_IGNORED=false
    if [ -n "${ENTRYPOINT}" ]; then
        COMPILE_ARGS=(compile --emit @ebusd/ebus-typespec "${ENTRYPOINT}" --output-dir outcsv)
        if [ "${LANG_CODE}" = de ]; then
            [ -f src/de.yaml ] || fail "Translation file src/de.yaml is missing."
            COMPILE_ARGS+=(--option @ebusd/ebus-typespec.translations=src/de.yaml)
        fi
        node node_modules/@typespec/compiler/cmd/tsp.js "${COMPILE_ARGS[@]}" \
            || COMPILE_EXIT=$?
    else
        npm run "compile-${LANG_CODE}" \
            || COMPILE_EXIT=$?
    fi
    if [ "${COMPILE_EXIT}" -ne 0 ]; then
        if [ "${IGNORE_COMPILE_ERRORS}" != true ]; then
            fail "TypeSpec compilation for ${LANG_CODE} failed (exit code ${COMPILE_EXIT}). Source errors are not ignored; existing exports remain unchanged."
        fi
        COMPILE_ERRORS_IGNORED=true
        ANY_COMPILE_ERRORS=true
        bashio::log.warning "Compilation for ${LANG_CODE} failed with exit code ${COMPILE_EXIT}. Because ignore_compile_errors=true, only CSVs already generated will be exported, if any. The errors are NOT fixed."
    fi
    mapfile -t OUTPUT_DIRS < <(find "${WORK_DIR}" -type d -name ebus-typespec \
        -path '*/@ebusd/*' ! -path '*/node_modules/*')
    [ "${#OUTPUT_DIRS[@]}" -eq 1 ] \
        || fail "Expected exactly one compiler output directory, found: ${#OUTPUT_DIRS[@]}"
    OUT_SRC=${OUTPUT_DIRS[0]}
    COUNT=$(find "${OUT_SRC}" -type f -name '*.csv' | wc -l)
    [ "${COUNT}" -gt 0 ] || fail "No CSV files generated for ${LANG_CODE}."
    mkdir "${WORK_DIR}/export-stage/${LANG_CODE}"
    cp -r "${OUT_SRC}/." "${WORK_DIR}/export-stage/${LANG_CODE}/"
    # Keep a reproducibility record alongside each language's output.
    printf 'repository=%s\nref=%s\ncommit=%s\ndependency_mode=%s\nentrypoint=%s\n' \
        "${REPO_URL}" "${BRANCH}" "${SOURCE_SHA}" "${DEPENDENCY_MODE}" "${ENTRYPOINT#${WORK_DIR}/}" \
        > "${WORK_DIR}/export-stage/${LANG_CODE}/.addon-build-info"
    printf 'ignore_compile_errors=%s\ncompile_exit_code=%s\ncompile_errors_ignored=%s\n' \
        "${IGNORE_COMPILE_ERRORS}" "${COMPILE_EXIT}" "${COMPILE_ERRORS_IGNORED}" \
        >> "${WORK_DIR}/export-stage/${LANG_CODE}/.addon-build-info"
    node -p 'JSON.stringify({compiler: require("./node_modules/@typespec/compiler/package.json").version, emitter: require("./node_modules/@ebusd/ebus-typespec/package.json").version})' \
        >> "${WORK_DIR}/export-stage/${LANG_CODE}/.addon-build-info"
    bashio::log.info "${LANG_CODE}: ${COUNT} CSV files provided."
done

# Publish only after every requested language has usable output. A nonzero
# compiler exit is accepted solely with the explicit ignore option.
mkdir -p "${OUTPUT_PATH}"
for LANG_CODE in ${LANGUAGES}; do
    TARGET="${OUTPUT_PATH}/${LANG_CODE}"
    STAGE=$(mktemp -d "${OUTPUT_PATH}/.${LANG_CODE}.XXXXXX")
    cp -r "${WORK_DIR}/export-stage/${LANG_CODE}/." "${STAGE}/"
    if [ -e "${TARGET}" ]; then
        mv -- "${TARGET}" "${STAGE}.previous"
    fi
    if ! mv -- "${STAGE}" "${TARGET}"; then
        if [ -e "${STAGE}.previous" ]; then mv -- "${STAGE}.previous" "${TARGET}"; fi
        fail "Export to ${TARGET} failed."
    fi
    rm -rf -- "${STAGE}.previous"
done
if [ "${ANY_COMPILE_ERRORS}" = true ]; then
    bashio::log.warning "Export completed with ignored compiler errors: commit ${SOURCE_SHA} under ${OUTPUT_PATH}. This is NOT a successful compile test; review the CSVs before productive use."
else
    bashio::log.info "Done. CSV files for commit ${SOURCE_SHA} exported to ${OUTPUT_PATH}."
fi
